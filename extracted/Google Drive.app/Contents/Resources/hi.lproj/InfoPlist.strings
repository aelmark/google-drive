"NSAppleEventsUsageDescription" = "'डेस्कटॉप के लिए Google Drive' को Microsoft Office का ऐक्सेस चाहिए, ताकि रीयल-टाइम मौजूदगी की सुविधा उपलब्ध कराई जा सके. इसकी मदद से आप देख सकते हैं कि Microsoft फ़ाइल में बदलाव कौन कर रहा है";
"NSDesktopFolderUsageDescription" = "'डेस्कटॉप के लिए Google Drive' को आपके डेस्कटॉप फ़ोल्डर में मौजूद फ़ाइलों का ऐक्सेस चाहिए, ताकि फ़ाइलों को सिंक किया जा सके और फ़ोटो और वीडियो का बैक अप लिया जा सके";
"NSDocumentsFolderUsageDescription" = "'डेस्कटॉप के लिए Google Drive' को आपके दस्तावेज़ फ़ोल्डर में मौजूद फ़ाइलों का ऐक्सेस चाहिए, ताकि फ़ाइलों को सिंक किया जा सके और फ़ोटो और वीडियो का बैक अप लिया जा सके";
"NSNetworkVolumesUsageDescription" = "'डेस्कटॉप के लिए Google Drive' को आपके नेटवर्क वॉल्यूम का ऐक्सेस चाहिए, ताकि फ़ोटो और वीडियो का बैक अप लिया जा सके";
"NSRemovableVolumesUsageDescription" = "'डेस्कटॉप के लिए Google Drive' को आपके यूएसबी या दूसरे हटाये जा सकने वाले मीडिया डिवाइस का ऐक्सेस चाहिए, ताकि फ़ाइलों को सिंक किया जा सके और फ़ोटो और वीडियो का बैक अप लिया जा सके";
"NSPhotoLibraryUsageDescription" = "'डेस्कटॉप के लिए Google Drive' को आपकी फ़ोटो लाइब्रेरी का ऐक्सेस चाहिए, ताकि फ़ाइलों को सिंक किया जा सके और फ़ोटो और वीडियो का बैक अप लिया जा सके";
"NSBluetoothAlwaysUsageDescription" = "ब्लूटूथ सुरक्षा कुंजी का इस्तेमाल करके 'डेस्कटॉप के लिए Google Drive' में साइन इन करने के लिए, Google Drive को ब्लूटूथ ऐक्सेस करने की अनुमति दें";
